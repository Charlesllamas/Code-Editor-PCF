<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="PCF" constructor="CodeEditor" version="1.3.0" display-name-key="Code_Editor_Name_Key" description-key="Code_Editor_Desc_Key" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <type-group name="text">
        <type>SingleLine.TextArea</type>
        <type>Multiple</type>
      </type-group>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="code" display-name-key="Code_Display_Key" description-key="Code_Desc_Key" of-type-group="text" usage="bound" required="true" />
    <property name="language" display-name-key="Language_Display_Key" description-key="Language_Desc_Key" of-type="SingleLine.Text" usage="input" required="true" />

    <!--
      An Enum rather than a TwoOptions, because the default is not "off": auto
      follows the app's theme, and a maker who never opens the property panel
      should get that. An Enum carries a real default-value; a TwoOptions
      cannot default to on (see the skill's property-types notes).
    -->
    <property name="theme" display-name-key="Theme_Display_Key" description-key="Theme_Desc_Key" of-type="Enum" usage="input" required="false" default-value="auto">
      <value name="auto" display-name-key="Theme_Auto_Key">auto</value>
      <value name="light" display-name-key="Theme_Light_Key">light</value>
      <value name="dark" display-name-key="Theme_Dark_Key">dark</value>
    </property>

    <!--
      No default-value, deliberately. The host's allocatedHeight wins whenever
      it is positive, and a default here would read as an override of it. Blank
      means "500px when the form allocates nothing", which is what 1.1.0 did.
    -->
    <property name="height" display-name-key="Height_Display_Key" description-key="Height_Desc_Key" of-type="Whole.None" usage="input" required="false" />

    <!-- Off by default is the honest default here: off is 1.1.0's behaviour. -->
    <property name="fitContent" display-name-key="FitContent_Display_Key" description-key="FitContent_Desc_Key" of-type="TwoOptions" usage="input" required="false" />

    <!--
      Strict JSON and well-formed XML, marked in the editor and named in the
      strip beneath it. An Enum so that on is the default; a column holding
      JSON with comments is what "off" is for.
    -->
    <property name="validation" display-name-key="Validation_Display_Key" description-key="Validation_Desc_Key" of-type="Enum" usage="input" required="false" default-value="on">
      <value name="on" display-name-key="Validation_On_Key">on</value>
      <value name="off" display-name-key="Validation_Off_Key">off</value>
    </property>

    <!--
      A JSON Schema the document is checked against, when validation is on.
      Starting with "{" it is the schema itself (a canvas formula can pass one);
      otherwise it is the name of a web resource in this environment, read
      same-origin — so no feature, no import prompt, and never another host.
      No default: blank is 1.2.0's behaviour.
    -->
    <property name="schema" display-name-key="Schema_Display_Key" description-key="Schema_Desc_Key" of-type="SingleLine.Text" usage="input" required="false" />

    <!--
      The control's own verdict, for a canvas app to act on — a Save button's
      DisplayMode, say. Outputs are permanent API: a formula may bind them.
      With validation off the verdict is the neutral one, valid and 0.
    -->
    <property name="isValid" display-name-key="IsValid_Display_Key" description-key="IsValid_Desc_Key" of-type="TwoOptions" usage="output" />
    <property name="problemCount" display-name-key="ProblemCount_Display_Key" description-key="ProblemCount_Desc_Key" of-type="Whole.None" usage="output" />

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/CodeEditor.css" order="1" />
      <resx path="strings/CodeEditor.1033.resx" version="1.0.0" />
      <resx path="strings/CodeEditor.3082.resx" version="1.0.0" />
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
